# using gcloud. It follows the same syntax as .gitignore

.gcloudignore
.git
.gitignore
node_modules
.env
.env.local
*.log
.vscode
.idea
*.swp
*.swo
*~
.DS_Store
frontend/node_modules
backend/node_modules
frontend/dist
backend/dist
*.backup

